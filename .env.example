# 本地开发：复制为 `apps/api/.env`；前端复制 `apps/web/.env.example` 为 `apps/web/.env`，
# 其中 VITE_API_BEARER_TOKEN 与本文件 API_BEARER_TOKEN 保持一致。

DATABASE_URL=postgresql+psycopg://xhs:xhs@127.0.0.1:5432/xiaohongshu
API_BEARER_TOKEN=dev-change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 本地上传图片：磁盘目录 + 写入草稿的 public_url 前缀（生产可改为对象存储/CDN 的 HTTPS 基址）
UPLOAD_DIR=data/uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000
