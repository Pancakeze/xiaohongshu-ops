# 复制为仓库根目录 .env.docker，供 docker compose --profile app 使用
# cp .env.docker.example .env.docker

API_BEARER_TOKEN=dev-change-me

# 容器内 API 连接数据库（服务名 postgres）
DATABASE_URL=postgresql+psycopg://xhs:xhs@postgres:5432/xiaohongshu

# 浏览器访问 API / 上传图 public_url 的前缀（映射到宿主机 8000）
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080

UPLOAD_DIR=data/uploads
GOOGLE_GENERATED_DIR=data/generated/google

# 宿主机 Ollama（Mac/Win Docker Desktop）
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 宿主机已用 --remote-debugging-port 启动的 Chrome（Google 生图，可选）
# GOOGLE_CHROME_CDP_URL=http://host.docker.internal:9222
